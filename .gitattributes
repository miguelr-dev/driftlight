# Normalize line endings; Unity YAML assets always use LF
* text=auto
*.cs       text diff=csharp
*.unity    text eol=lf
*.prefab   text eol=lf
*.asset    text eol=lf
*.mat      text eol=lf
*.meta     text eol=lf
*.anim     text eol=lf
*.controller text eol=lf
*.shadergraph text eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.psd  binary
*.tga  binary
*.exr  binary
*.hdr  binary
*.fbx  binary
*.blend binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
*.mp4  binary
