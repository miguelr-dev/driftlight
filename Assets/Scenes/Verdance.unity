  m_Script: {fileID: 11500000, guid: bb91691eea6e44ef1831fa478eeee1eb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Driftlight.SignalFragment
  fragmentTitle: SIGNAL FRAGMENT 1 / 3
  loreText: '"The gardens sang again tonight. Every flower on Verdance turned to the sky at the same moment, as if something up there had called our names. The elders say it is only the season. But the signal is in the soil now, in the roots, in us. Tomorrow, all of us will answer it."'
  afterObjective: Fragment recovered. The signal goes deeper into the system (next planet coming soon)
  interactRange: 4.5
  crystal: {fileID: 715531902}
  glowLight: {fileID: 1814932792}
