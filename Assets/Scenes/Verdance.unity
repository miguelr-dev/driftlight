  m_Script: {fileID: 11500000, guid: 2fb85175f56bb41bda5278fcb44905aa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Driftlight.Hud
  controlsText: 'MOUSE  steer

    LEFT CLICK  fire

    W / S  thrust / brake

    A / D  strafe

    Q / E  roll

    SPACE / CTRL  up / down

    SHIFT  boost

    HOLD F  warp (when unlocked)

    ESC  free the mouse'
  footControlsText: 'MOUSE  look

    W A S D  move

    SHIFT  sprint

    SPACE  jump

    E  interact

